DB_URL=Seubanco
DB_USER=teste
DB_PASSWORD=sua senha

# n8n: use a URL do webhook de produção e o mesmo segredo no workflow
N8N_ALERT_WEBHOOK_URL=https://n8n.seudominio.com/webhook/toffco-events
N8N_WEBHOOK_SECRET=troque-por-um-segredo-forte
N8N_REVIEW_MODE=false
# Use rabbitmq em produção quando o n8n estiver usando o nó RabbitMQ Trigger
N8N_TRANSPORT=webhook

# WhatsApp Business Platform oficial (Cloud API).
# Deixe false para continuar usando o bridge Baileys.
WHATSAPP_META_ENABLED=false
META_GRAPH_URL=https://graph.facebook.com
META_GRAPH_VERSION=v23.0
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=
META_APP_SECRET=
META_READ_TIMEOUT=PT8S

# Bridge Baileys mantido apenas para rollback durante a migração.
WHATSAPP_BRIDGE_URL=http://localhost:3100
WHATSAPP_BRIDGE_SECRET=troque-por-um-segredo-forte
