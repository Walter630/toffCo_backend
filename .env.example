DB_URL=Seubanco
DB_USER=teste
DB_PASSWORD=sua senha

# n8n: use a URL do webhook de produção e o mesmo segredo no workflow
N8N_ALERT_WEBHOOK_URL=https://n8n.seudominio.com/webhook/toffco-events
N8N_WEBHOOK_SECRET=troque-por-um-segredo-forte
N8N_REVIEW_MODE=false
# Use rabbitmq em produção quando o n8n estiver usando o nó RabbitMQ Trigger
N8N_TRANSPORT=webhook
