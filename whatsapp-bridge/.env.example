# ─── CONFIGURAÇÃO DO WHATSAPP BRIDGE ───────────────────────────

# Porta em que o bridge escuta (o backend Java chama aqui)
BRIDGE_PORT=3100

# URL do backend Java que vai receber as mensagens
# Quando uma msg chega no WhatsApp, o bridge faz POST nesse endpoint
BACKEND_WEBHOOK_URL=http://localhost:8081/api/webhook/whatsapp/receive

# URL base do backend (para consultar blocklist, etc.)
# Se não definido, é extraído automaticamente do BACKEND_WEBHOOK_URL
# BACKEND_BASE_URL=http://localhost:8081

# Segredo compartilhado entre bridge e backend (validação simples)
BRIDGE_SECRET=troque-por-um-segredo-forte

# Pasta onde salva a sessão do WhatsApp (auth)
# Se apagar essa pasta, precisa escanear QR code de novo
AUTH_FOLDER=./auth_data

# Log level: debug, info, warn, error
LOG_LEVEL=info
